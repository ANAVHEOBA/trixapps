{
  "expo": {
    "name": "Trixapps",
    "slug": "Trixapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.trixapps"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.trixapps"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/AntDesign.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Entypo.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/EvilIcons.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome5_Brands.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome5_Regular.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome5_Solid.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Fontisto.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Foundation.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Octicons.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/SimpleLineIcons.ttf",
            "@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Zocial.ttf"
          ]
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "sdkVersion": "52.0.0"
  }
}